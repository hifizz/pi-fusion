{
  "name": "pi-fusion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent lead/sidekick Pi extension and reproducible local evaluations",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.11.2",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "fusion:costs": "node src/costs-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "eval": "node evals/cli.ts",
    "eval:validate-tasks": "node evals/validate-tasks.ts",
    "report": "node evals/report-cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  }
}
