# pnpm-specific settings (storeDir, cacheDir, enableGlobalVirtualStore, ignoreScripts,
# updateNotifier) live in pnpm-workspace.yaml — pnpm >= 10 ignores them here.
# stateDir is machine-level only in pnpm 12: pass --state-dir=.cache/pnpm/state on the CLI.
# Kept for plain-npm compatibility if this package is ever installed without pnpm:
ignore-scripts=true
update-notifier=false
